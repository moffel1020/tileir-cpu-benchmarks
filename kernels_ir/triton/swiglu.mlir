module {
  tt.func public @swiglu_fwd_triton(%gate_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("gate_ptr"(#loc)), %up_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("up_ptr"(#loc)), %output_ptr: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("output_ptr"(#loc)), %n_cols: i32 {tt.divisibility = 16 : i32} loc("n_cols"(#loc))) attributes {noinline = false} {
    %c16_i32 = arith.constant 16 : i32 loc(#loc1)
    %c0_i32 = arith.constant 0 : i32 loc(#loc1)
    %cst = arith.constant dense<1.000000e+00> : tensor<16xf32> loc(#loc2)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<16xf32> loc(#loc2)
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc2)
    %bid = tt.get_program_id x : i32 loc(#loc24)
    %offsets = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32> loc(#loc25)
    %mask = tt.splat %n_cols : i32 -> tensor<16xi32> loc(#loc26)
    %gate_tile = arith.muli %bid, %c1024_i32 : i32 loc(#loc27)
    %gate_tile_1 = tt.addptr %gate_ptr, %gate_tile : !tt.ptr<f32>, i32 loc(#loc28)
    %gate_tile_2 = tt.splat %gate_tile_1 : !tt.ptr<f32> -> tensor<16x!tt.ptr<f32>> loc(#loc28)
    %up_tile = tt.addptr %up_ptr, %gate_tile : !tt.ptr<f32>, i32 loc(#loc29)
    %up_tile_3 = tt.splat %up_tile : !tt.ptr<f32> -> tensor<16x!tt.ptr<f32>> loc(#loc29)
    %0 = tt.addptr %output_ptr, %gate_tile : !tt.ptr<f32>, i32 loc(#loc9)
    %1 = tt.splat %0 : !tt.ptr<f32> -> tensor<16x!tt.ptr<f32>> loc(#loc9)
    scf.for %i = %c0_i32 to %c1024_i32 step %c16_i32  : i32 {
      %offsets_4 = tt.splat %i : i32 -> tensor<16xi32> loc(#loc30)
      %offsets_5 = arith.addi %offsets_4, %offsets : tensor<16xi32> loc(#loc30)
      %mask_6 = arith.cmpi slt, %offsets_5, %mask : tensor<16xi32> loc(#loc26)
      %gate_tile_7 = tt.addptr %gate_tile_2, %offsets_5 : tensor<16x!tt.ptr<f32>>, tensor<16xi32> loc(#loc28)
      %gate_tile_8 = tt.load %gate_tile_7, %mask_6, %cst_0 : tensor<16x!tt.ptr<f32>> loc(#loc31)
      %up_tile_9 = tt.addptr %up_tile_3, %offsets_5 : tensor<16x!tt.ptr<f32>>, tensor<16xi32> loc(#loc29)
      %up_tile_10 = tt.load %up_tile_9, %mask_6, %cst_0 : tensor<16x!tt.ptr<f32>> loc(#loc32)
      %denom = arith.subf %cst_0, %gate_tile_8 : tensor<16xf32> loc(#loc33)
      %denom_11 = math.exp %denom : tensor<16xf32> loc(#loc34)
      %denom_12 = arith.addf %denom_11, %cst : tensor<16xf32> loc(#loc35)
      %sig = arith.divf %cst, %denom_12 : tensor<16xf32> loc(#loc36)
