      %result = arith.mulf %silu_gate, %up_tile_10 : tensor<16xf32> loc(#loc38)
      %2 = tt.addptr %1, %offsets_5 : tensor<16x!tt.ptr<f32>>, tensor<16xi32> loc(#loc9)
