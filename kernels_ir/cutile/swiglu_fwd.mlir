    %reshape_19 = reshape %arg0 : tile<ptr<f32>> -> tile<1xptr<f32>>
    %bcast_20 = broadcast %reshape_19 : tile<1xptr<f32>> -> tile<1024xptr<f32>>
    %14 = offset %bcast_20, %13 : tile<1024xptr<f32>>, tile<1024xi64> -> tile<1024xptr<f32>>
    %reshape_21 = reshape %cst_0_f32 : tile<f32> -> tile<1xf32>
    %bcast_22 = broadcast %reshape_21 : tile<1xf32> -> tile<1024xf32>
    %result, %result_token = load_ptr_tko weak %14, %10, %bcast_22 token=%0 : tile<1024xptr<f32>>, tile<1024xi1>, tile<1024xf32> -> tile<1024xf32>, token
    %cst_0_f32_23 = constant <f32: 0.000000e+00> : tile<f32>
