    %bcast_33 = broadcast %reshape_32 : tile<1xi64> -> tile<1024xi64>
    %25 = muli %20, %bcast_33 : tile<1024xi64>
    %26 = addi %19, %25 : tile<1024xi64>
    %reshape_34 = reshape %arg5 : tile<ptr<f32>> -> tile<1xptr<f32>>
    %bcast_35 = broadcast %reshape_34 : tile<1xptr<f32>> -> tile<1024xptr<f32>>
    %27 = offset %bcast_35, %26 : tile<1024xptr<f32>>, tile<1024xi64> -> tile<1024xptr<f32>>
    %reshape_36 = reshape %cst_0_f32_23 : tile<f32> -> tile<1xf32>
