cuda_tile.module @kernels {
  entry @swiglu_fwd(%arg0: tile<ptr<f32>>, %arg1: tile<i32>, %arg2: tile<i32>, %arg3: tile<i32>, %arg4: tile<i32>, %arg5: tile<ptr<f32>>, %arg6: tile<i32>, %arg7: tile<i32>, %arg8: tile<i32>, %arg9: tile<i32>, %arg10: tile<ptr<f32>>, %arg11: tile<i32>, %arg12: tile<i32>, %arg13: tile<i32>, %arg14: tile<i32>) optimization_hints=<sm_89 = {}> {
    %0 = make_token : token
    %assume = assume bounded<0, ?>, %arg1 : tile<i32>
    %assume_0 = assume bounded<0, ?>, %arg2 : tile<i32>
    %assume_1 = assume bounded<0, ?>, %arg6 : tile<i32>
    %assume_2 = assume bounded<0, ?>, %arg7 : tile<i32>
    %assume_3 = assume bounded<0, ?>, %arg11 : tile<i32>
    %assume_4 = assume bounded<0, ?>, %arg12 : tile<i32>
    %blockId_x, %blockId_y, %blockId_z = get_tile_block_id : tile<i32>
    %1 = iota : tile<4096xi32>
    %cst_0_f32 = constant <f32: 0.000000e+00> : tile<f32>
    %2 = exti %blockId_x signed : tile<i32> -> tile<i64>
    %reshape = reshape %2 : tile<i64> -> tile<1xi64>
    %bcast = broadcast %reshape : tile<1xi64> -> tile<4096xi64>
    %3 = exti %assume signed : tile<i32> -> tile<i64>
    %reshape_5 = reshape %3 : tile<i64> -> tile<1xi64>
    %bcast_6 = broadcast %reshape_5 : tile<1xi64> -> tile<4096xi64>
    %4 = cmpi less_than %bcast, %bcast_6, unsigned : tile<4096xi64> -> tile<4096xi1>
    %cst_4096_i64 = constant <i64: 4096> : tile<i64>
    %reshape_7 = reshape %cst_4096_i64 : tile<i64> -> tile<1xi64>
    %bcast_8 = broadcast %reshape_7 : tile<1xi64> -> tile<4096xi64>
    %5 = muli %bcast, %bcast_8 : tile<4096xi64>
    %6 = exti %1 signed : tile<4096xi32> -> tile<4096xi64>
    %7 = exti %assume_0 signed : tile<i32> -> tile<i64>
    %reshape_9 = reshape %7 : tile<i64> -> tile<1xi64>
    %bcast_10 = broadcast %reshape_9 : tile<1xi64> -> tile<4096xi64>
    %8 = cmpi less_than %6, %bcast_10, unsigned : tile<4096xi64> -> tile<4096xi1>
    %9 = andi %4, %8 : tile<4096xi1>
    %10 = addi %5, %6 : tile<4096xi64>
    %reshape_11 = reshape %arg0 : tile<ptr<f32>> -> tile<1xptr<f32>>
    %bcast_12 = broadcast %reshape_11 : tile<1xptr<f32>> -> tile<4096xptr<f32>>
    %11 = offset %bcast_12, %10 : tile<4096xptr<f32>>, tile<4096xi64> -> tile<4096xptr<f32>>
    %reshape_13 = reshape %cst_0_f32 : tile<f32> -> tile<1xf32>
    %bcast_14 = broadcast %reshape_13 : tile<1xf32> -> tile<4096xf32>
    %result, %result_token = load_ptr_tko weak %11, %9, %bcast_14 token=%0 : tile<4096xptr<f32>>, tile<4096xi1>, tile<4096xf32> -> tile<4096xf32>, token
    %cst_0_f32_15 = constant <f32: 0.000000e+00> : tile<f32>
    %12 = exti %blockId_x signed : tile<i32> -> tile<i64>
    %reshape_16 = reshape %12 : tile<i64> -> tile<1xi64>
    %bcast_17 = broadcast %reshape_16 : tile<1xi64> -> tile<4096xi64>
    %13 = exti %assume_1 signed : tile<i32> -> tile<i64>
    %reshape_18 = reshape %13 : tile<i64> -> tile<1xi64>
    %bcast_19 = broadcast %reshape_18 : tile<1xi64> -> tile<4096xi64>
    %14 = cmpi less_than %bcast_17, %bcast_19, unsigned : tile<4096xi64> -> tile<4096xi1>
    %cst_4096_i64_20 = constant <i64: 4096> : tile<i64>
    %reshape_21 = reshape %cst_4096_i64_20 : tile<i64> -> tile<1xi64>
    %bcast_22 = broadcast %reshape_21 : tile<1xi64> -> tile<4096xi64>
    %15 = muli %bcast_17, %bcast_22 : tile<4096xi64>
    %16 = exti %1 signed : tile<4096xi32> -> tile<4096xi64>
    %17 = exti %assume_2 signed : tile<i32> -> tile<i64>
    %reshape_23 = reshape %17 : tile<i64> -> tile<1xi64>
    %bcast_24 = broadcast %reshape_23 : tile<1xi64> -> tile<4096xi64>
    %18 = cmpi less_than %16, %bcast_24, unsigned : tile<4096xi64> -> tile<4096xi1>
    %19 = andi %14, %18 : tile<4096xi1>
    %20 = addi %15, %16 : tile<4096xi64>
    %reshape_25 = reshape %arg5 : tile<ptr<f32>> -> tile<1xptr<f32>>
    %bcast_26 = broadcast %reshape_25 : tile<1xptr<f32>> -> tile<4096xptr<f32>>
    %21 = offset %bcast_26, %20 : tile<4096xptr<f32>>, tile<4096xi64> -> tile<4096xptr<f32>>
    %reshape_27 = reshape %cst_0_f32_15 : tile<f32> -> tile<1xf32>
    %bcast_28 = broadcast %reshape_27 : tile<1xf32> -> tile<4096xf32>
    %result_29, %result_token_30 = load_ptr_tko weak %21, %19, %bcast_28 token=%0 : tile<4096xptr<f32>>, tile<4096xi1>, tile<4096xf32> -> tile<4096xf32>, token
    %cst_1_f32 = constant <f32: 1.000000e+00> : tile<f32>
    %22 = negf %result : tile<4096xf32>
    %23 = exp %22 : tile<4096xf32>
    %reshape_31 = reshape %cst_1_f32 : tile<f32> -> tile<1xf32>
    %bcast_32 = broadcast %reshape_31 : tile<1xf32> -> tile<4096xf32>
    %24 = addf %bcast_32, %23  flush_to_zero : tile<4096xf32>
    %cst_1_f32_33 = constant <f32: 1.000000e+00> : tile<f32>
    %reshape_34 = reshape %cst_1_f32_33 : tile<f32> -> tile<1xf32>
    %bcast_35 = broadcast %reshape_34 : tile<1xf32> -> tile<4096xf32>
    %25 = divf %bcast_35, %24 rounding<approx> flush_to_zero : tile<4096xf32>
    %26 = mulf %result, %25  flush_to_zero : tile<4096xf32>
    %27 = mulf %26, %result_29  : tile<4096xf32>
    %28 = exti %blockId_x signed : tile<i32> -> tile<i64>
    %reshape_36 = reshape %28 : tile<i64> -> tile<1xi64>
    %bcast_37 = broadcast %reshape_36 : tile<1xi64> -> tile<4096xi64>
    %29 = exti %assume_3 signed : tile<i32> -> tile<i64>
    %reshape_38 = reshape %29 : tile<i64> -> tile<1xi64>
    %bcast_39 = broadcast %reshape_38 : tile<1xi64> -> tile<4096xi64>
    %30 = cmpi less_than %bcast_37, %bcast_39, unsigned : tile<4096xi64> -> tile<4096xi1>
    %cst_4096_i64_40 = constant <i64: 4096> : tile<i64>
    %reshape_41 = reshape %cst_4096_i64_40 : tile<i64> -> tile<1xi64>
    %bcast_42 = broadcast %reshape_41 : tile<1xi64> -> tile<4096xi64>
    %31 = muli %bcast_37, %bcast_42 : tile<4096xi64>
    %32 = exti %1 signed : tile<4096xi32> -> tile<4096xi64>
    %33 = exti %assume_4 signed : tile<i32> -> tile<i64>
    %reshape_43 = reshape %33 : tile<i64> -> tile<1xi64>
    %bcast_44 = broadcast %reshape_43 : tile<1xi64> -> tile<4096xi64>
    %34 = cmpi less_than %32, %bcast_44, unsigned : tile<4096xi64> -> tile<4096xi1>
    %35 = andi %30, %34 : tile<4096xi1>
    %36 = addi %31, %32 : tile<4096xi64>
    %reshape_45 = reshape %arg10 : tile<ptr<f32>> -> tile<1xptr<f32>>
    %bcast_46 = broadcast %reshape_45 : tile<1xptr<f32>> -> tile<4096xptr<f32>>
    %37 = offset %bcast_46, %36 : tile<4096xptr<f32>>, tile<4096xi64> -> tile<4096xptr<f32>>
    %38 = store_ptr_tko weak %37, %27, %35 token=%0 : tile<4096xptr<f32>>, tile<4096xf32>, tile<4096xi1> -> token
    return
  }
}
