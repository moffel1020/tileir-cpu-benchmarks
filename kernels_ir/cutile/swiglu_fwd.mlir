    %36 = cmpi less_than %bcast_46, %bcast_48, unsigned : tile<1024xi64> -> tile<1024xi1>
    %37 = exti %assume_9 signed : tile<i32> -> tile<i64>
    %reshape_49 = reshape %37 : tile<i64> -> tile<1xi64>
    %bcast_50 = broadcast %reshape_49 : tile<1xi64> -> tile<1024xi64>
    %38 = muli %bcast_46, %bcast_50 : tile<1024xi64>
